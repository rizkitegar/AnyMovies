<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/genreSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/genreRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/genre_list_content_description"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/genreShimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <include layout="@layout/view_genre_shimmer_row" />
        <include layout="@layout/view_genre_shimmer_row" />
        <include layout="@layout/view_genre_shimmer_row" />
        <include layout="@layout/view_genre_shimmer_row" />
        <include layout="@layout/view_genre_shimmer_row" />
        <include layout="@layout/view_genre_shimmer_row" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/genreErrorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/genreErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            tools:text="No internet connection. Check your network and try again." />

        <Button
            android:id="@+id/genreErrorRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/genre_error_retry" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/genreEmptyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/genreEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/genre_empty_title"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
